# ---- ParkTrieste configuration ----
# Copy this file to .env and fill in the values. NEVER commit .env.

# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# Admin account (created on first run)
ADMIN_EMAIL=admin@parktrieste.it
ADMIN_PASSWORD=change-me-admin

# WhatsApp operator number in E.164 format (no spaces, no dashes)
# Receives the prefilled booking messages and owner-request notifications.
WHATSAPP_OPERATOR=+390401234567

# Google Search Console site verification token (HTML tag method).
# Get it from https://search.google.com/search-console -> Add property -> HTML tag.
# Copy only the "content" value, e.g. AbCdEf1234567890. Leave blank until then.
GOOGLE_SITE_VERIFICATION=

# Stripe Connect (marketplace) - SERVER ONLY, never expose in front-end code.
# With a secret key set, owners onboard as Express connected accounts and drivers
# pay by card/wallet on a Stripe-hosted Checkout page. ParkTrieste keeps EUR 1
# as an application fee on each payment (direct charge on the owner's account).
# Leave STRIPE_SECRET_KEY blank to run in pilot mode (Payment Link / manual marking).
STRIPE_SECRET_KEY=
# Webhook endpoint: https://YOUR-DOMAIN/webhook/stripe
# Subscribe to: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# charge.refunded, account.updated
STRIPE_WEBHOOK_SECRET=
# Legacy pilot fallback: Payment Link for the EUR 1 fee. ParkTrieste appends
# ?client_reference_id=PT-0000 so the booking code travels with the payment.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxxxxxxxxxxx

# Owner email notifications (optional). Leave blank to use WhatsApp only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ParkTrieste <noreply@parktrieste.it>
