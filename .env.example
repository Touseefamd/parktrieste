# ---- ParkTrieste configuration ----
# Copy this file to .env and fill in the values. NEVER commit .env.

# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# Admin account (created on first run)
ADMIN_EMAIL=admin@parktrieste.it
ADMIN_PASSWORD=change-me-admin

# WhatsApp operator number in E.164 format (no spaces, no dashes)
# Receives the prefilled booking messages and owner-request notifications.
WHATSAPP_OPERATOR=+390401234567

# Stripe Payment Link for the EUR 1 booking fee.
# ParkTrieste appends ?client_reference_id=PT-0000 so the code comes back with payment.
STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxxxxxxxxxxx

# Stripe secret key - SERVER ONLY. Never expose this in front-end code.
# Optional in pilot mode: the admin can mark the fee paid manually.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Owner email notifications (optional). Leave blank to use WhatsApp only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ParkTrieste <noreply@parktrieste.it>
